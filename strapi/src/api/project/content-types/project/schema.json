{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": ["images"]
    },
    "description": {
      "type": "text",
      "required": false
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag-category.tag-category"
    },
    "support_fields": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag-support-field.tag-support-field"
    },
    "year": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tag-year.tag-year"
    },
    "program": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tag-program.tag-program"
    },
    "districts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag-district.tag-district"
    },
    "legal_form": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tag-legal-form.tag-legal-form"
    },
    "goals": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag-goal.tag-goal"
    },
    "appliciant": {
      "type": "string",
      "required": true
    },
    "amount": {
      "type": "string"
    }
  }
}
