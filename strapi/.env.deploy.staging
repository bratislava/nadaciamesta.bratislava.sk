# Non-secret env for the staging cluster, read at deploy time by
# infrastructure-deployment-configuration and turned into the app ConfigMap.
# Every value must fit on a single line: no line continuation, no escapes.
# Secrets (APP_KEYS, *_SALT, *_SECRET, ENCRYPTION_KEY, MINIO_*_KEY) live in
# Passbolt; database credentials come from the strapi-cnpg secret.

NODE_ENV=production
PUBLIC_URL=https://nadaciamesta-strapi.staging.bratislava.sk

# Media bucket, shared by all clusters
MINIO_BUCKET=nadaciamesta
MINIO_PRIVATE_ENDPOINT=https://s3.bratislava.sk
MINIO_PUBLIC_ENDPOINT=https://nadaciamesta.s3.bratislava.sk
