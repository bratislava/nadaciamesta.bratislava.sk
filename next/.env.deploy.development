# Non-secret env for the development cluster, read at deploy time by
# infrastructure-deployment-configuration and turned into the app ConfigMap.
# Every value must fit on a single line: no line continuation, no escapes.
# Secrets (MAILGUN_API_KEY) live in Passbolt, never here.

NODE_ENV=production
# Server-side rendering talks to the Strapi service in the same namespace.
STRAPI_URL=http://nadaciamesta-strapi
MAILGUN_DOMAIN=noreply.nadaciamestabratislavy.sk
